# Frontend y API comparten el dominio en Vercel; VITE_API_URL se deja vacío.
VITE_API_URL=

# Backend
PUBLIC_SITE_URL=https://galvezlg.vercel.app
PUBLIC_API_URL=https://galvezlg.vercel.app
MP_ACCESS_TOKEN=APP_USR-REEMPLAZAR
MP_WEBHOOK_SECRET=REEMPLAZAR
ADMIN_USERNAME=REEMPLAZAR
ADMIN_PASSWORD=REEMPLAZAR

# Contacto por correo (el remitente debe pertenecer a un dominio verificado en Resend).
RESEND_API_KEY=re_REEMPLAZAR
CONTACT_FROM_EMAIL=Gálvez Motos <contacto@tudominio.com>
CONTACT_TO_EMAIL=mailTest@mail.com

# La integración Postgres de Vercel/Neon crea esta variable automáticamente.
DATABASE_URL=postgresql://REEMPLAZAR